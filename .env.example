# Copy to .env and fill in. Never commit .env.

# Sign-in for the orb. Use a long password; this file is chmod 600.
ORB_EMAIL=
ORB_PASSWORD=
# How long a sign-in lasts on a device (days)
SESSION_DAYS=30

# The gateway inside agentnet (compose service name + port)
OPENCLAW_URL=http://openclaw-gateway:18789

# Same value as OPENCLAW_GATEWAY_TOKEN in your OpenClaw .env
OPENCLAW_TOKEN=

# How the orb talks to OpenClaw:
#   auto (default) = full tools over the gateway WebSocket (browser, images, files, like the OpenClaw chat),
#                    using the basic HTTP chat endpoint only until the orb is approved as a device
#   http           = basic HTTP chat endpoint only (text in, text out)
TRANSPORT=auto

# Agent the orb opens with
DEFAULT_AGENT=main

# Optional: only show these agents in the picker (comma list). Blank = all.
AGENTS=

# Optional: friendly names shown on screen
AGENT_LABELS=main=Kira,forge=Forge,ledger=Ledger

# Optional: orb colour per agent (hex). Agents not listed get a colour automatically.
AGENT_COLORS=main=#ff7ac8,forge=#4da3ff,ledger=#4fe39a

# Pocket TTS voice service (cloned agent voices). Blank = browser voices only.
VOICE_URL=http://voice:8000

# Optional fallback: what each acronym stands for. Normally read from each agent's SOUL.md
# (a line like "## K.I.R.A. - Kobler Insights Robotic Agent"), so this can stay blank.
AGENT_TITLES=

# ---- heartbeat monitoring (docs/heartbeat.md) ----
# Seconds between agent heartbeats. LATE after 1.5x, STALLED/DOWN after 3x this.
HEARTBEAT_INTERVAL_S=30
# How often the orb checks each agent through the gateway (seconds)
PROBE_INTERVAL_S=30
# Busy with no progress for this long = STALLED (only for senders that report progress)
STALL_AFTER_S=300
# Who owns liveness alerts (shown on every alert)
HEARTBEAT_ALERT_OWNER=operator
# Optional: POST every alert here (e.g. an n8n webhook that posts to Slack). Each carries an Idempotency-Key.
HEARTBEAT_WEBHOOK_URL=
# Optional: lets Prometheus/Grafana read /metrics with "Authorization: Bearer <token>" instead of signing in
METRICS_TOKEN=
