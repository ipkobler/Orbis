claw.bigsixtech.tech {
  # /v1 is OpenClaw's chat API (full operator access). Only the orb uses it, from inside agentnet.
  @blocked path /hooks* /v1/*
  respond @blocked 404
  reverse_proxy openclaw-gateway:18789
}


n8n.bigsixtech.tech {
  reverse_proxy n8n:5678
}

mailman.bigsixtech.tech {
  handle /admin* {
    reverse_proxy mailer:8080
  }
  handle / {
    redir * /admin
  }
  handle {
    respond "Not found" 404
  }
}

