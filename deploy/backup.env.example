# /docker/agent-stack/backup.env   (chmod 600 — it holds the encryption passphrase)

# 07:30 UTC = 3:30 AM Eastern (2:30 AM in winter)
BACKUP_CRON_EXPRESSION=30 7 * * *
BACKUP_FILENAME=agent-stack-%Y-%m-%dT%H-%M.tar.gz
BACKUP_PRUNING_PREFIX=agent-stack-
BACKUP_RETENTION_DAYS=14

# Ollama's and Chatterbox's model files are re-downloadable, so skip them.
BACKUP_EXCLUDE_REGEXP=ollama/models|voice-cache

# REQUIRED. The backup contains .env, your gateway token and OpenViking's ChatGPT login.
# Store this passphrase in your password manager. Without it the backups can't be opened.
GPG_PASSPHRASE=

# ---- Off-site copy (recommended). Uncomment ONE of these. ----
# Backblaze B2 (S3-compatible, about $6/TB/month; this stack is tiny):
# AWS_S3_BUCKET_NAME=bigsix-agent-stack-backups
# AWS_ENDPOINT=s3.us-east-005.backblazeb2.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
