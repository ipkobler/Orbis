# /docker/agent-stack/voice.env   (chmod 600)
# Needed for Pocket TTS: its model weights are gated on Hugging Face.
# 1. Sign in at huggingface.co, open https://huggingface.co/kyutai/pocket-tts and accept the terms.
# 2. Profile picture (top right) → Settings → Access Tokens → Create new token → type "Read" → copy it.
HF_TOKEN=hf_replace_me
