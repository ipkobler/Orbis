# /docker/agent-stack/voice.env   (optional: only create it if the voice logs show a 401/403 download error)
# The Chatterbox Nano model is public, so no token is normally needed.
# If you do need one: huggingface.co → Settings → Access Tokens → New token (Read).
# Never leave HF_TOKEN empty; delete the file instead.
HF_TOKEN=hf_replace_me
